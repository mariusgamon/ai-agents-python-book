# Copy this file to .env, then fill in your keys:  cp .env.example .env
# The .env file is never committed (see .gitignore).

# === Required (every day) ===
OPENAI_API_KEY=sk-proj-your-key-here
DEFAULT_MODEL=gpt-5.4-mini
LOG_LEVEL=INFO

# Turns off sending traces to OpenAI (GDPR / privacy — see §5.5)
# OPENAI_AGENTS_DISABLE_TRACING=1

# === Day 2 / 5 — weather agent, tools/weather.py ===
OPENWEATHER_API_KEY=

# === Day 5 — observability (optional) ===
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# LOGFIRE_TOKEN=

# === Day 6 — FastAPI API (also in day6/.env.example) ===
API_SECRET_KEY=change-me-in-production

# === Day 7 — case studies ===
SLACK_WEBHOOK_URL=
GITHUB_TOKEN=

# === Bonus chapter "from scratch" ===
MISTRAL_API_KEY=

# === Appendix C — multi-provider ===
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENROUTER_API_KEY=sk-or-...
# LLM_PROVIDER=openai   # or anthropic (multi_provider_langgraph.py)
